# Streamlit Community Cloud -> your app -> Settings -> Secrets: paste this, filled in.
# Locally, use .env instead (secrets.toml is gitignored either way).
# There is deliberately NO Groq key here: visitors bring their own.

ADMIN_USERNAME = "admin"
ADMIN_PASSWORD = ""   # long and random, e.g.  python -c "import secrets; print(secrets.token_urlsafe(18))"

# Neon: console.neon.tech -> your project -> Connect -> pooled connection string
DATABASE_URL = "postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Clerk sign-in for the chat page (admin page uses ADMIN_USERNAME/ADMIN_PASSWORD instead).
# Clerk dashboard -> Configure -> OAuth applications -> add one (confidential, scopes: openid profile email).
# Remove this whole [auth] section to keep the chat open without sign-in.
[auth]
redirect_uri = "https://YOUR-APP.streamlit.app/oauth2callback"   # locally: http://localhost:8501/oauth2callback
cookie_secret = ""   # long and random

[auth.clerk]
client_id = ""
client_secret = ""
server_metadata_url = "https://YOUR-INSTANCE.clerk.accounts.dev/.well-known/openid-configuration"
# Clerk rejects Streamlit's default prompt="select_account"; set a value Clerk accepts.
client_kwargs = { scope = "openid profile email", prompt = "consent" }
