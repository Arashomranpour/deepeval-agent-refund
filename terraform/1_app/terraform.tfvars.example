# Copy to terraform.tfvars (gitignored) and adjust.
subscription_id   = ""           # empty = the subscription `az account show` prints
project_name      = "deepeval-refund"
location          = "germanywestcentral" # Azure for Students allows only some regions; run scripts/azure_bootstrap.sh
container_image   = ""           # leave empty: CI deploys the real image
min_replicas      = 0            # 0 = scale to zero (cheapest), 1 = always warm
store_today       = "2026-10-16"
enable_front_door = false        # true = Azure Front Door CDN in front (~$35/month base)
budget_alert_email = ""          # your e-mail = monthly budget alerts; empty = no budget
monthly_budget     = 10
admin_username     = "admin"
